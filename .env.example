# Copy to .env.local and fill in real values. Never commit .env.local.
# Also used by `docker compose --env-file .env.local up --build`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seed target (used by scripts/seed-amazon-walmart.mjs, not required to run the app)
SEED_ORG_ID=
SEED_START_DATE=
SEED_TIMEZONE_OFFSET=

# Email (Resend)
RESEND_API_KEY=
STUDENT_FEEDBACK_EMAIL_FROM=
EMAIL_FROM=
TEACHER_SETUP_EMAIL_FROM=
