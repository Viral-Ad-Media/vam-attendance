# All credentials are runtime/server-only. Never commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.us-east-1.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate BETTER_AUTH_SECRET once with: openssl rand -base64 32
# Optional email (required for verification, teacher setup and password recovery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_FROM=
TEACHER_SETUP_EMAIL_FROM=
STUDENT_FEEDBACK_EMAIL_FROM=
STUDENT_FEEDBACK_EMAIL_REPLY_TO=
# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Demo data target
SEED_ORG_ID=
SEED_START_DATE=
SEED_TIMEZONE_OFFSET=
